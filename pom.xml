	<version>9.10.0</version>
	</dependency>
	<!--  https://mvnrepository.com/artifact/org.apache.lucene/lucene-analysis-common  -->
	<dependency>
	<groupId>org.apache.lucene</groupId>
	<artifactId>lucene-analysis-common</artifactId>
	<version>9.10.0</version>
	</dependency>
